# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Groq API key (console.groq.com) — free Whisper transcription
GROQ_API_KEY=

# REQUIRED — comma-separated Telegram user IDs allowed to use the bot.
# If empty or unset, ALL access is denied (fail-closed).
# Find yours by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Notion integration (optional)
# Share your database/root page with your Notion integration first.
NOTION_API_KEY=
# If client notes are in a database, set this:
NOTION_CLIENTS_DATABASE_ID=
# If notes are nested under a root page, set this too:
NOTION_CLIENTS_ROOT_PAGE_ID=
# Page where Yuki saves generated client resources:
NOTION_RESOURCES_PAGE_ID=
# Optional
# NOTION_VERSION=2022-06-28
# NOTION_TIMEOUT_SECONDS=15

# Optional: override default file paths
# GOOGLE_CALENDAR_CREDENTIALS=/path/to/google-calendar-credentials.json
# GOOGLE_CALENDAR_TOKEN=/path/to/calendar_token.json
# Gmail integration (optional, defaults to calendar credentials path)
# GMAIL_CREDENTIALS_FILE=/path/to/google-oauth-client.json
# GMAIL_TOKEN_FILE=/path/to/gmail_token.json
# MEMORY_FILE=/path/to/memory.md
# TIMEZONE=America/Los_Angeles
