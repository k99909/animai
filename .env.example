# Telegram bot token (from @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Groq API key (console.groq.com) — free Whisper transcription
GROQ_API_KEY=

# REQUIRED — comma-separated Telegram user IDs allowed to use the bot.
# If empty or unset, ALL access is denied (fail-closed).
# Find yours by messaging @userinfobot on Telegram.
ALLOWED_USER_IDS=

# Path to your Obsidian vault
OBSIDIAN_VAULT_PATH=/path/to/your/obsidian/vault

# Optional: override default file paths
# GOOGLE_CALENDAR_CREDENTIALS=/path/to/google-calendar-credentials.json
# GOOGLE_CALENDAR_TOKEN=/path/to/calendar_token.json
# MEMORY_FILE=/path/to/memory.md
# TIMEZONE=America/Los_Angeles
